DB_HOST=localhost
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_database
CLOUDINARY_CLOUD_NAME=hnje0kky
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

PORT=3001

# Cloudflare R2 private File Vault storage
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=gpas-secure-vault
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key


# Required: use a unique random secret with at least 32 characters
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Gmail SMTP recovery email (never commit real values)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
